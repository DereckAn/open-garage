# Clerk keys — from Clerk Dashboard → API keys. NOTE the PUBLIC_ prefix (Astro, not NEXT_PUBLIC_).
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Comma-separated list of emails allowed to open the garage.
ALLOWED_EMAILS=you@example.com,friend@example.com

# EMQX Cloud Serverless — App ID/Secret (console → Deployment Overview → API Key).
EMQX_HOST=xxxxxxxx.ala.us-east-1.emqxsl.com
EMQX_APP_ID=xxxxxxxx
EMQX_APP_SECRET=xxxxxxxx
