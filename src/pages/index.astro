---
import Layout from '../layouts/Layout.astro';
import { UserButton } from '@clerk/astro/components';
// One door for now. id must match a known door in src/pages/api/door/[id].ts.
const doors = [{ id: '1', name: 'Garage principal' }];
// ids must match src/pages/api/light/[id].ts and the relay order in firmware/lights.
const lights = [{ id: '1', name: 'Luz 1 recámara' }, { id: '2', name: 'Luz 2 recámara' }];
---
<Layout title="Garage">
  <main class="min-h-screen bg-slate-950 p-6 text-white">
    <div class="mx-auto w-full max-w-md">
      <header class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold">Mis puertas</h1>
          <p class="text-sm text-slate-400">{doors.length} dispositivo{doors.length === 1 ? '' : 's'}</p>
        </div>
        <div class="flex items-center gap-3">
          {Astro.locals.isAdmin && <a href="/admin" class="text-sm text-cyan-400">Admin</a>}
          <UserButton />
        </div>
      </header>

      <ul class="mt-6 space-y-3">
        {doors.map((d) => (
          <li class="door flex items-center gap-4 rounded-xl bg-slate-900 p-4 text-left ring-1 ring-white/10 transition hover:ring-cyan-400/40"
              data-id={d.id} data-name={d.name} role="button" tabindex="0">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-slate-800 text-cyan-400">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21V9l9-5 9 5v12" stroke-linecap="round" stroke-linejoin="round"/><rect x="7" y="12" width="10" height="9" rx="1"/></svg>
            </span>
            <div class="min-w-0 flex-1">
              <p class="truncate font-semibold">{d.name}</p>
              <p class="text-sm text-slate-400">Toque para activar</p>
            </div>
            <svg class="h-5 w-5 shrink-0 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </li>
        ))}
      </ul>

      <h2 class="mt-8 text-lg font-bold">Luces</h2>
      <ul class="mt-3 space-y-3">
        {lights.map((l) => (
          <li class="flex items-center gap-3 rounded-xl bg-slate-900 p-4 ring-1 ring-white/10">
            <div class="min-w-0 flex-1">
              <p class="truncate font-semibold">{l.name}</p>
              <p class="light-status h-5 text-sm text-slate-400"></p>
            </div>
            <button class="light rounded-lg bg-amber-400 px-4 py-2 font-bold text-slate-950 active:scale-[.98] disabled:opacity-50" data-id={l.id} data-on="true">Encender</button>
            <button class="light rounded-lg bg-slate-700 px-4 py-2 font-bold active:scale-[.98] disabled:opacity-50" data-id={l.id} data-on="false">Apagar</button>
          </li>
        ))}
      </ul>
    </div>

    <!-- Modal: single toggle action (no open/closed state — the door is a momentary toggle) -->
    <div id="modal" class="fixed inset-0 z-50 hidden items-end justify-center bg-black/60 p-4 backdrop-blur-sm sm:items-center">
      <section class="w-full max-w-sm rounded-2xl bg-slate-900 p-6 text-center ring-1 ring-white/10">
        <div class="flex items-center justify-between">
          <h2 id="m-name" class="text-lg font-bold"></h2>
          <button id="m-close" class="grid h-8 w-8 place-items-center rounded-lg text-slate-400 hover:bg-slate-800">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
          </button>
        </div>

        <div class="mx-auto mt-8 grid h-28 w-28 place-items-center rounded-full bg-slate-800 text-cyan-400">
          <svg class="h-14 w-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21V9l9-5 9 5v12" stroke-linecap="round" stroke-linejoin="round"/><rect x="7" y="12" width="10" height="9" rx="1"/></svg>
        </div>

        <p id="m-status" class="mt-6 h-5 text-sm font-medium text-slate-400"></p>

        <button id="m-toggle"
          class="mt-4 w-full rounded-xl bg-cyan-400 py-4 text-lg font-bold text-slate-950 transition active:scale-[.98] disabled:opacity-50">
          Activar puerta
        </button>
      </section>
    </div>
  </main>

  <script is:inline>
    const modal = document.getElementById('modal');
    const mName = document.getElementById('m-name');
    const mStatus = document.getElementById('m-status');
    const mToggle = document.getElementById('m-toggle');
    let activeId = null;

    const openModal = (li) => {
      activeId = li.dataset.id;
      mName.textContent = li.dataset.name;
      mStatus.textContent = '';
      mStatus.className = 'mt-6 h-5 text-sm font-medium text-slate-400';
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    };
    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      activeId = null;
    };

    document.querySelectorAll('.door').forEach((li) => {
      li.addEventListener('click', () => openModal(li));
      li.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(li); } });
    });

    mToggle.addEventListener('click', async () => {
      if (!activeId) return;
      mToggle.disabled = true;
      mStatus.textContent = 'Enviando…';
      mStatus.className = 'mt-6 h-5 text-sm font-medium text-slate-400';
      try {
        const res = await fetch(`/api/door/${activeId}`, { method: 'POST' });
        if (!res.ok) throw new Error(String(res.status));
        mStatus.textContent = 'Enviado ✓';
        mStatus.className = 'mt-6 h-5 text-sm font-medium text-emerald-400';
      } catch {
        mStatus.textContent = 'Error al enviar';
        mStatus.className = 'mt-6 h-5 text-sm font-medium text-rose-400';
      } finally {
        setTimeout(() => { mToggle.disabled = false; }, 1500);
      }
    });

    // ponytail: no on/off state shown — we only know what we last sent, not the relay
    document.querySelectorAll('.light').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const status = btn.parentElement.querySelector('.light-status');
        btn.disabled = true;
        status.textContent = 'Enviando…';
        try {
          const res = await fetch(`/api/light/${btn.dataset.id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ on: btn.dataset.on === 'true' }),
          });
          if (!res.ok) throw new Error(String(res.status));
          status.textContent = btn.dataset.on === 'true' ? 'Encendida ✓' : 'Apagada ✓';
        } catch {
          status.textContent = 'Error al enviar';
        } finally {
          btn.disabled = false;
        }
      });
    });

    document.getElementById('m-close').addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && activeId) closeModal(); });
  </script>
</Layout>
