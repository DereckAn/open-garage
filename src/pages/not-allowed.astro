---
import Layout from '../layouts/Layout.astro';
import { SignOutButton } from '@clerk/astro/components';
---
<Layout title="Sin acceso">
  <main class="grid min-h-screen place-items-center bg-slate-950 p-6 text-center text-white">
    <section class="w-full max-w-sm">
      <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-rose-500/15 text-rose-400">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round"/></svg>
      </div>
      <h1 class="mt-5 text-2xl font-bold">Sin acceso</h1>
      <p class="mt-2 text-slate-400">Tu cuenta no está autorizada para abrir esta puerta.</p>
      <SignOutButton class="mt-6 inline-flex rounded-lg bg-slate-800 px-4 py-2 font-semibold text-slate-100 ring-1 ring-white/10">
        Cerrar sesión
      </SignOutButton>
    </section>
  </main>
</Layout>
